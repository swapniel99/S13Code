# S13Code contains no provider keys. Provider credentials belong to glc_v3.
GLC_BASE_URL=http://127.0.0.1:8111
S13_GATEWAY_PROVIDER=gemini
S13_PORT=8113
S13_BASE_URL=http://127.0.0.1:8113
S13_A2A_GRPC_ENABLED=1
S13_A2A_GRPC_PORT=8114
S13_OLLAMA_URL=http://localhost:11434
S13_EMBED_MODEL=nomic-embed-text
S13_CHUNK_MODEL=phi4:latest
S13_LIVE_SEMANTIC_CHUNKING=1
S13_PLANNER_LLM=0
S13_MAX_WORKERS=4

# Data directory for SQLite DBs and runtime state (default: ~/.s13code)
# S13_DATA_DIR=~/.s13code

# Set this to an absolute path before using local file skills.
S13_SANDBOX_ROOT=/absolute/path/to/S13Code/sandbox

# A2A Security & Auth (Optional)
# S13_A2A_BEARER_TOKENS=token1,token2
# S13_A2A_API_KEYS=key1,key2
# S13_A2A_PRIVATE_KEY_FILE=/path/to/private_key.pem
S13_A2A_SIGNING_KID=s13-local
# S13_A2A_PUSH_SIGNING_SECRET=secret
